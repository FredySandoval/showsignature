{
  "name": "showcode",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "bin": {
    "showcode": "./dist/app.js"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:binary": "bun build ./src/app.ts --compile --outfile ./dist/showcode",
    "build:js": "bun build ./src/index.ts ./src/app.ts --outdir ./dist --target=node --format=esm",
    "build:types": "tsc -p ./tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "clean": "git clean -xdf node_modules",
    "typecheck": "tsgo --noEmit"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Extract structure from code. Turn source files into clean, readable artifacts.",
  "dependencies": {
    "commander": "^10.0.0",
    "fast-glob": "^3.3.0"
  }
}
